--- !u!114 &1232903241
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1232903240}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 500131fe45d833e4db506095911dfffd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialPanel: {fileID: 603322202}
  nameText: {fileID: 1651540838}
  dialogueText: {fileID: 1457710284}
  startTutorial:
  - characterName: 'Kala:'
    dialogueText: "Se que me escuchas maldita borracha, Rami me dej\xF3 a cargo as\xED
      que no te hagas la tonta."
  - characterName: 'Kala:'
    dialogueText: "Tienes que aplastar a esos monstruos infernales antes de que lleguen
      m\xE1s a la energ\xEDa."
  - characterName: 'Kala:'
    dialogueText: "Ellos dijeron que impidieramos que maten a m\xE1s gente as\xED
      que eso haremos."
  - characterName: 'Kala:'
    dialogueText: "Usa (icono joystick) para moverte, eso s\xED eres una tortuga
      lenta y aburrida."
  - characterName: 'Kala:'
    dialogueText: "Lo mejor ser\xE1 que te impulses a ti misma contra esas cosas
      (icono deslizamiento) as\xED har\xE1s tu trabajo m\xE1s r\xE1pido. "
  - characterName: 'Kala:'
    dialogueText: "No olvides informarme cuando t\xFA y tus haraganas amigas hayan
      terminado de limpiar."
  levelUpTutorial:
  - characterName: 'Kala:'
    dialogueText: "Bien hecho degenerada, acabas de subir de nivel, te mostrar\xE9
      lo que puedo hacer."
  - characterName: 'Kala:'
    dialogueText: "Estoy envi\xE1ndote mejoras, toca la mejora que te parezca m\xE1s
      poderosa y rompeles la jeta."
  - characterName: 'Kala:'
    dialogueText: "Podr\xE1s tener 4 mejoras hasta el nivel 4, me agradeces despu\xE9s."
  - characterName: 'Kala:'
    dialogueText: "Por cierto, algunos bichos est\xE1n botando las lukas de vez en
      cuando."
  - characterName: 'Kala:'
    dialogueText: "Tr\xE1eme esa plata y te podr\xE1s comprar mis aparatos m\xE1s
      chimbas de todos los tiempos. "
  - characterName: 'Ramo:'
    dialogueText: Oigan a esta disque mis aparatos.
  - characterName: 'Kala:'
    dialogueText: "Bueno m\xEDos y de Ramo, ella entendi\xF3 manito deja de ser cans\xF3n."
  hasShownStartTutorial: 0
  hasShownLevelUpTutorial: 0
